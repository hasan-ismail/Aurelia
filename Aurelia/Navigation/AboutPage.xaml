<Page x:Class="Aurelia.Navigation.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Aurelia" xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:controls="clr-namespace:Aurelia.Controls"
      xmlns:utils="clr-namespace:Aurelia.Utilities"
      xmlns:resx="clr-namespace:Aurelia.Properties"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800">
    <controls:ScrollViewerEx>
        <ui:SimpleStackPanel Spacing="10" Margin="20">
            <TextBlock FontWeight="SemiBold" Style="{DynamicResource TitleTextBlockStyle}"
                       Text="{x:Static local:Program.AppName}" />
            <Image Source="/Assets/Images/Aurelia_128.png" HorizontalAlignment="Left" Height="128" />
            <TextBlock TextWrapping="Wrap" Text="{x:Static resx:Strings.About_AppDescription}" />
            <TextBlock TextWrapping="Wrap" FontWeight="Bold" FontStyle="Italic" Text="{x:Static resx:Strings.About_FileABug}" />
            <TextBlock>
                <Run Text="{x:Static resx:Strings.About_Version}" />
                <Bold>
                    <Run Text="{x:Static local:Program.AppVersion}" />
                </Bold>
            </TextBlock>
            <ui:HyperlinkButton Content="{x:Static resx:Strings.About_GitHub}"
                                NavigateUri="https://github.com/hasan-ismail/Aurelia" />
            <ui:HyperlinkButton Content="{x:Static resx:Strings.About_Contributors}"
                                NavigateUri="https://github.com/hasan-ismail/Aurelia/graphs/contributors" />
            <ui:HyperlinkButton Content="{x:Static resx:Strings.About_Dependencies}"
                                NavigateUri="https://github.com/hasan-ismail/Aurelia/network/dependencies" />
            <ui:HyperlinkButton Content="{x:Static resx:Strings.About_OpenNewIssue}"
                                NavigateUri="https://github.com/hasan-ismail/Aurelia/issues/new/choose" />

            <!-- The AGPL expects an interactive program to show its copyright, state that there is
                 no warranty, and say how to read the licence. The source link is what the licence
                 is ultimately about, so it belongs here too. -->
            <Border Margin="0,10,0,0" Padding="14" CornerRadius="8"
                    Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
                <ui:SimpleStackPanel Spacing="6">
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="{x:Static resx:Strings.About_License}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.7"
                               Style="{DynamicResource CaptionTextBlockStyle}"
                               Text="{x:Static local:Program.Copyright}" />
                    <ui:SimpleStackPanel Orientation="Horizontal" Spacing="4">
                        <ui:HyperlinkButton Content="{x:Static resx:Strings.About_ViewLicense}"
                                            NavigateUri="https://github.com/hasan-ismail/Aurelia/blob/main/LICENSE" />
                        <ui:HyperlinkButton Content="{x:Static resx:Strings.About_SourceCode}"
                                            NavigateUri="https://github.com/hasan-ismail/Aurelia" />
                        <ui:HyperlinkButton Content="{x:Static resx:Strings.About_ThirdPartyNotices}"
                                            NavigateUri="https://github.com/hasan-ismail/Aurelia/blob/main/NOTICE.md" />
                    </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
            </Border>
        </ui:SimpleStackPanel>
    </controls:ScrollViewerEx>
</Page>
